{
  "name": "mca-cli",
  "version": "1.6.7",
  "description": "CLI application for MCA team",
  "author": "Nordcloud Managed Cloud Applications",
  "license": "MIT",
  "main": "./dist/bin/mca.js",
  "preferGlobal": true,
  "bin": {
    "mca": "./dist/bin/mca.js"
  },
  "files": [
    "dist/**/*",
    "assets/**/*"
  ],
  "scripts": {
    "test": "ava --verbose --timeout=2m",
    "lint": "eslint . --ext ts",
    "lint:fix": "eslint . --ext ts --fix",
    "start": "tsc -w -p .",
    "watch": "tsc -w -p .",
    "build": "tsc -p .",
    "release": "standard-version",
    "prepare": "npm run build"
  },
  "dependencies": {
    "aws-sdk": "^2.1219.0",
    "chalk": "^4.1.2",
    "diff": "^5.2.0",
    "handlebars": "^4.7.6",
    "inquirer": "^7.3.3",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.0",
    "yargs": "^15.4.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.0",
    "@types/inquirer": "^7.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^15.0.0",
    "@types/picomatch": "^4.0.0",
    "@types/yargs": "^15.0.3",
    "@typescript-eslint/eslint-plugin": "^2.20.0",
    "@typescript-eslint/parser": "^2.20.0",
    "ava": "^4.0.0",
    "eslint": "^6.8.0",
    "eslint-plugin-import": "^2.20.1",
    "standard-version": "^9.5.0",
    "ts-node": "^8.6.2",
    "typescript": "^3.7.5"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended"
    ]
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register"
    ]
  }
}
